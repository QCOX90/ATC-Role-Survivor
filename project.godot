config_version=5

[application]
config/name="ATC Role Survivor"
run/main_scene="res://scenes/airport.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1360
window/size/viewport_height=820
window/size/window_width_override=1360
window/size/window_height_override=820
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
